{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "Data Source=inventory.db"
  },
  "EnableSwagger": true,
  "Jwt": {
    "Key": "dev-only-secret-change-me-in-production-1234567890-abcdef",
    "Issuer": "InventoryApi",
    "Audience": "InventoryApiClients",
    "ExpiryMinutes": 60
  },
  "Metrics": {
    "User": "metrics",
    "Password": "local-metrics-secret"
  }
}
